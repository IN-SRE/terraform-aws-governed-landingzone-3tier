
{
    "accessManagement": {
        "enabled": false    
    },
    "backup": {
        "enabled": false,   
        "configurations": {
            "backupAdmin": {
                "accountId": "${common_account}"
            },
            "centralBackup": {
                "accountId": "${common_account}"  
            },   
            "kmsKeyArn": "${kms_key_arn}"
        }
    },
    "centralizedLogging": {
        "accountId": "${log_archieve}",   
        "enabled": true,             
        "configurations": {
            "accessLoggingBucket": {
                "retentionDays": 2 
            },  
            "loggingBucket": {
                "retentionDays": 2
            }
            
        }
    },
    "config": {
        "accountId": "${log_archieve}",    
        "enabled": false,                
        "configurations": {
            "accessLoggingBucket": {
                "retentionDays": 2 
            },
            "loggingBucket": {
                "retentionDays": 2   
            }
           
        }
    },
    "governedRegions": [               
        "us-east-1",
        "us-west-2"
    ],
    "securityRoles": {
        "enabled": false,               
        "accountId": "${security_audit}"   
    }
}
    

